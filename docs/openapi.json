    "/tickets/{ticket_id}/analyze": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Analyze Ticket",
        "description": "Ask the local model for an advisory category, priority and troubleshooting steps.\nThe suggestion is stored separately; the ticket itself is not changed.",
        "operationId": "analyze_ticket_tickets__ticket_id__analyze_post",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Ticket Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionOut"
                }
              }
            }
          },
          "404": {
            "description": "Ticket not found"
          },
          "502": {
            "description": "Model returned invalid content; nothing was saved"
          },
          "503": {
            "description": "Model not running, not installed or timed out; nothing was saved"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
