      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Give Feedback",
        "description": "Staff accept or correct an AI suggestion and mark it useful or not.\nThe final values become the ticket's confirmed category/priority (with history rows).\nStatus is never changed here.",
        "operationId": "give_feedback_tickets__ticket_id__feedback_post",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
