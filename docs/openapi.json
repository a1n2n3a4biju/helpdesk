          "Tickets"
        ],
        "summary": "List Tickets",
        "operationId": "list_tickets_tickets_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "New",
                    "In Progress",
                    "Resolved"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
