# Copy to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/helpdesk
TEST_DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/helpdesk_test
FRONTEND_URL=http://localhost:5173

# Local AI (Ollama). Free local model, no API key needed.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=90

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/helpdesk.log
